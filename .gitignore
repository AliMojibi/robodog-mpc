# Python
__pycache__/
*.pyc
.venv/

# Licensed / third-party reference documents (kept local only)
references/*.pdf

# acados generated code and outputs
c_generated_code*/
acados_ocp*.json
acados_sim*.json
*.png

# Earlier all-in-one notebook (kept local only)
notebooks/srbd_derivation.ipynb
.ipynb_checkpoints/

# simulation results
*.npz

# showcase video (kept local; the README uses the GIF)
showcase/*.mp4
robodog_nmpc/scripts/derivation/*.gif

# editor settings (contain local paths)
.vscode/

# personal planning / assistant notes (local only)
PLAN.md
CLAUDE.md

# generated acados C solver (output of robodog_nmpc/scripts/generate_solver.py): only the C sources/headers and
# the marker file are committed (whitelist), so build output (.o, .so, json, Makefile, ...) can never slip in
robodog_nmpc/solver/**
!robodog_nmpc/solver/**/
!robodog_nmpc/solver/**/*.c
!robodog_nmpc/solver/**/*.h
!robodog_nmpc/solver/.generated_by_generate_solver
# test output of test_generate_solver.py
robodog_nmpc/solver_test/

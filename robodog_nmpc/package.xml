<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>robodog_nmpc</name>
  <version>0.1.0</version>
  <description>Nonlinear MPC (single-rigid-body model) for quadruped ground reaction forces</description>
  <maintainer email="alimojibi99@gmail.com">Ali Mojibi</maintainer>
  <license>BSD-3-Clause</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <depend>eigen</depend>
  <depend>yaml-cpp</depend>
  <test_depend>ament_cmake_gtest</test_depend>
  <!-- acados is not a ROS package: it is found through ACADOS_SOURCE_DIR (see CMakeLists.txt) -->

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
